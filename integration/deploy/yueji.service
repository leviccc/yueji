[Unit]
Description=Yueji unified novel reading workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yueji
Group=yueji
WorkingDirectory=/opt/yueji/current
EnvironmentFile=/etc/yueji.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/yueji/venv/bin/uvicorn integration.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=4
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yueji
UMask=0077
MemoryHigh=1200M
MemoryMax=1800M
TasksMax=128

[Install]
WantedBy=multi-user.target

